<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.AlikDroneDiscordWeb" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:colorAccent">@color/brand</item>
        <item name="android:windowBackground">@color/background</item>
        <item name="android:statusBarColor">@color/background</item>
        <item name="android:navigationBarColor">@color/background</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="Widget.AlikDroneDiscordWeb.PrimaryButton" parent="@android:style/Widget.Material.Button">
        <item name="android:layout_width">220dp</item>
        <item name="android:layout_height">54dp</item>
        <item name="android:background">@drawable/button_primary</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
