<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />

    <!-- Package visibility only. The Hub requests no dangerous permissions. -->
    <queries>
        <package android:name="dji.go.v5" />
        <package android:name="dji.go.v4" />
        <package android:name="dji.pilot" />
        <package android:name="com.android.packageinstaller" />
        <package android:name="com.android.documentsui" />
        <package android:name="org.telegram.messenger" />
        <package android:name="org.telegram.messenger.web" />
        <package android:name="org.thunderdog.challegram" />
        <package android:name="com.discord" />
        <package android:name="ru.alikdrone.discordweb" />
        <package android:name="su.happ.proxyutility" />
        <package android:name="com.lenovo.anyshare.gps" />
        <package android:name="info.dvkr.screenstream" />
        <package android:name="com.asdoi.quicktiles" />
        <package android:name="com.android.chrome" />
        <package android:name="com.chrome.beta" />
        <package android:name="com.chrome.dev" />
        <package android:name="com.chrome.canary" />
        <package android:name="org.chromium.chrome" />
        <package android:name="org.cromite.cromite" />
        <package android:name="com.android.browser" />
        <package android:name="com.google.android.youtube" />
        <package android:name="com.google.android.youtube.tv" />
        <package android:name="ru.rutube.app" />
        <package android:name="rtb.mobile.android" />
        <package android:name="com.windyty.android" />
        <package android:name="io.livekit.android.compose.meet" />
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.AlikDroneHub">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="landscape"
            tools:ignore="DiscouragedApi">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".DeviceInfoActivity"
            android:exported="false"
            android:screenOrientation="landscape"
            tools:ignore="DiscouragedApi" />

        <activity
            android:name=".OperationsActivity"
            android:exported="false"
            android:screenOrientation="landscape"
            tools:ignore="DiscouragedApi" />

        <activity
            android:name=".WebToolsActivity"
            android:exported="false"
            android:screenOrientation="landscape"
            tools:ignore="DiscouragedApi" />

        <activity
            android:name=".SupportReportActivity"
            android:exported="false"
            android:screenOrientation="landscape"
            tools:ignore="DiscouragedApi" />

        <activity
            android:name=".ControllerFilesActivity"
            android:exported="false"
            android:screenOrientation="landscape"
            tools:ignore="DiscouragedApi" />

        <activity
            android:name=".MissionLibraryActivity"
            android:exported="false"
            android:screenOrientation="landscape"
            tools:ignore="DiscouragedApi" />

        <activity
            android:name=".MaintenanceActivity"
            android:exported="false"
            android:screenOrientation="landscape"
            tools:ignore="DiscouragedApi" />

        <service
            android:name=".FloatingSwitcherService"
            android:directBootAware="true"
            android:enabled="true"
            android:exported="false"
            android:stopWithTask="false"
            tools:ignore="UnusedAttribute" />

        <provider
            android:name=".InventoryApkProvider"
            android:authorities="ru.alikdrone.hub.inventory"
            android:exported="false"
            android:grantUriPermissions="true" />

        <receiver
            android:name=".BootReceiver"
            android:directBootAware="true"
            android:enabled="true"
            android:exported="false"
            tools:ignore="UnusedAttribute">
            <intent-filter>
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.USER_UNLOCKED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".SplitInstallResultReceiver"
            android:enabled="true"
            android:exported="false" />
    </application>

</manifest>
