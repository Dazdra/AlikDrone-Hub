<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <gradient
                android:angle="0"
                android:endColor="#14322F"
                android:startColor="@color/surface_raised" />
            <stroke
                android:width="1dp"
                android:color="@color/brand" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item>
        <shape>
            <gradient
                android:angle="270"
                android:endColor="#09121B"
                android:startColor="#0E1A27" />
            <stroke
                android:width="1dp"
                android:color="@color/stroke" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</selector>
