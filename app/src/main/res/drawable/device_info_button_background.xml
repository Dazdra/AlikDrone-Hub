<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <gradient
                android:angle="0"
                android:endColor="#123D3A"
                android:startColor="#0A2928" />
            <stroke
                android:width="1dp"
                android:color="@color/brand" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item>
        <shape>
            <gradient
                android:angle="0"
                android:endColor="#0D312F"
                android:startColor="@color/brand_dark" />
            <stroke
                android:width="1dp"
                android:color="#7445D4C0" />
            <corners android:radius="10dp" />
        </shape>
    </item>
</selector>
