<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="10dp"
        android:paddingEnd="20dp"
        android:paddingBottom="8dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/switcher_settings_explanation"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <TextView
            style="@style/Widget.AlikDrone.SectionLabel"
            android:layout_marginTop="16dp"
            android:text="@string/switcher_rows_label" />

        <Spinner
            android:id="@+id/spinner_taskbar_rows"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:spinnerMode="dropdown" />

        <TextView
            style="@style/Widget.AlikDrone.SectionLabel"
            android:layout_marginTop="12dp"
            android:text="@string/switcher_columns_label" />

        <Spinner
            android:id="@+id/spinner_taskbar_columns"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:spinnerMode="dropdown" />

        <TextView
            style="@style/Widget.AlikDrone.SectionLabel"
            android:layout_marginTop="12dp"
            android:text="@string/switcher_sort_label" />

        <Spinner
            android:id="@+id/spinner_taskbar_sort"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:spinnerMode="dropdown" />

        <TextView
            style="@style/Widget.AlikDrone.SectionLabel"
            android:layout_marginTop="12dp"
            android:text="@string/switcher_position_label" />

        <Spinner
            android:id="@+id/spinner_taskbar_anchor"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:spinnerMode="dropdown" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/switcher_category_hint"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
