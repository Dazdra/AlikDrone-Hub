<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/screen_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/button_controller_files_back"
                style="@style/Widget.AlikDrone.GhostButton"
                android:layout_width="108dp"
                android:layout_height="44dp"
                android:text="← Назад" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Файлы пульта"
                    android:textColor="@color/text_primary"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Только выбранная вами папка Android"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />
            </LinearLayout>

            <Button
                android:id="@+id/button_controller_files_choose"
                style="@style/Widget.AlikDrone.SecondaryButton"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:text="Выбрать папку" />

            <Button
                android:id="@+id/button_controller_files_refresh"
                style="@style/Widget.AlikDrone.GhostButton"
                android:layout_width="112dp"
                android:layout_height="44dp"
                android:layout_marginStart="8dp"
                android:text="Обновить" />
        </LinearLayout>

        <TextView
            android:id="@+id/controller_files_location"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:textColor="@color/brand"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/controller_files_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/card_background"
            android:padding="12dp"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <LinearLayout
            android:id="@+id/controller_files_rows"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical" />
    </LinearLayout>
</ScrollView>
